# SET&PLATE — production environment template.
# Copy to .env and replace every value marked TODO.
# Never commit the real .env: it is gitignored.
#
# Public exposure via Tailscale Funnel:
#   tailscale funnel --bg 8080   ->   https://<machine>.<tailnet>.ts.net
# Cloudflare Tunnel works too; put its public hostname in the same fields.

# --- SUPABASE ---
# Dashboard -> Project Settings -> API.
# The service-role key bypasses RLS, so it must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---
# Optional. Leave empty to keep the rule-based features.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIPS_MODEL=openai/gpt-oss-120b
AI_TIPS_MODEL_ENABLED=false

# Photo meal scanning. Use an OpenAI-compatible provider and a vision-capable
# model. Leave blank to disable the Scan plate flow with a clear 503.
# Example: AI_VISION_MODEL=gpt-4o-mini with AI_VISION_BASE_URL=https://api.openai.com/v1
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

# --- AUTH ---
# TODO: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Signs the bearer sessions. Rotating it logs every user out.
# Required: docker-compose refuses to start while it is empty.
AUTH_SECRET_KEY=
# Session lifetime in hours. 12 = daily re-login, 168 = weekly.
AUTH_TOKEN_TTL_HOURS=12
# Comma-separated user UUIDs allowed to run maintenance jobs (wger import).
# Empty means nobody, which is the safe default.
ADMIN_USER_IDS=

# --- DEPLOYMENT ---
# "production" disables /docs and /openapi.json.
ENVIRONMENT=production
# TODO: hostname only — no scheme, no port, no trailing slash.
# Tailscale Funnel example: zimaos.tailxxxx.ts.net
# (the exact value printed by `tailscale funnel status`).
# Always keep 127.0.0.1 and localhost: the container HEALTHCHECK calls
# http://127.0.0.1:8000/health, and without them the backend reports
# unhealthy and the frontend never starts (depends_on: service_healthy).
ALLOWED_HOSTS=127.0.0.1,localhost,your-machine.your-tailnet.ts.net
# Origin the browser actually uses: scheme + host, no trailing slash.
# "*" is rejected on purpose and the backend will not boot.
CORS_ORIGINS=https://your-machine.your-tailnet.ts.net
# Loopback port the tunnel forwards to: `tailscale funnel --bg 8080`.
# Compose publishes 127.0.0.1:${APP_PORT} only, never 0.0.0.0. If you change
# it, use the same number in the funnel command or the tunnel returns 502.
APP_PORT=8080
WEB_CONCURRENCY=1

# --- FRONTEND ---
# Fixed to "" by docker-compose.yml so the SPA calls nginx on its own origin.
# Do not set this: a different host breaks the CSP (connect-src 'self').
VITE_API_URL=
