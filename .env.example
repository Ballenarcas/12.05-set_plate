
# Conexión Supabase (URL y Clave Anon / Service Role desde el Dashboard del proyecto)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_backend_only
# GroqCloud AI configuration
GROQ_API_KEY=your_groqcloud_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- AUTH ---
# Signs the bearer sessions. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates every active session. Never commit the real value.
AUTH_SECRET_KEY=replace_with_a_random_48_byte_secret
AUTH_TOKEN_TTL_HOURS=12
# UUIDs allowed to call maintenance endpoints such as the wger import.
ADMIN_USER_IDS=

# --- DEPLOYMENT ---
# "production" disables /docs and /openapi.json.
ENVIRONMENT=production
# Host header allow-list for the public domain, comma-separated.
ALLOWED_HOSTS=tu-dominio.example.com
APP_PORT=8080

# --- FRONTEND ---
# Production API base URL. Leave empty when nginx proxies /api on the same origin.
VITE_API_URL=

# Comma-separated frontend origins accepted by FastAPI. Never use "*".
CORS_ORIGINS=https://tu-dominio.example.com
