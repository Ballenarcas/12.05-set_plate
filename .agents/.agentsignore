# Agent Context Ignore File (.agentsignore)
# Prevents autonomous agents from scanning, indexing, or ingesting token-heavy paths

# Dependencies and Virtual Environments
backend/venv/
backend/.venv/
venv/
.venv/
env/
node_modules/
frontend/node_modules/
*/node_modules/
*/venv/
*/.venv/

# Build and Dist Directories
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/

# Caches and Temporary Files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eslintcache/
*.cache
*.tmp

# Logs and Debug Dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles (High Token Density, Read Only on Demand)
package-lock.json
yarn.lock
pnpm-lock.yaml
poetry.lock
Pipfile.lock

# Media and Binary Assets
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.webp
*.mp4
*.mp3
*.wav
*.pdf
*.zip
*.tar.gz
*.exe
*.dll
*.so
*.dylib

# System & IDE Configs
.git/
.vscode/
.idea/
.DS_Store
Thumbs.db
