
# Conexión Supabase (URL y Clave Anon / Service Role desde el Dashboard del proyecto)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_backend_only
# GroqCloud AI configuration
GROQ_API_KEY=your_groqcloud_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- FRONTEND ---
# Production API base URL. Leave empty when nginx proxies /api on the same origin.
VITE_API_URL=

# Comma-separated frontend origins accepted by FastAPI
CORS_ORIGINS=http://localhost:5173,http://localhost:8080