# Homelab demo environment for docker-compose.yml.
# Copy this file to .env.homelab and fill in the real values.
# Never commit .env.homelab.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Leave empty for a zero-cost demo; AI workout adjustment will be unavailable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Host port for the web app. Change it if 8080 is already in use.
APP_PORT=8080

# Leave empty to use the nginx same-origin proxy (recommended).
VITE_API_URL=

# Only needed for direct browser-to-API calls on another origin.
CORS_ORIGINS=http://localhost:8080

# Backend workers. 1 is enough for a small demo.
WEB_CONCURRENCY=1
