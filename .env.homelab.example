# Homelab demo environment for docker-compose.yml (ZimaOS / Portainer).
# Copy to .env.homelab and fill in the TODOs:
#   docker compose --env-file .env.homelab up -d --build
# In Portainer, paste the same keys into the stack's environment variables.
# Never commit .env.homelab.

# --- SUPABASE ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI ---
# Optional. Leave empty for a zero-cost demo.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- AUTH (required) ---
# TODO: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty on purpose: the stack refuses to start until you fill it.
AUTH_SECRET_KEY=
# A demo box rarely reboots, so a week avoids constant re-login.
AUTH_TOKEN_TTL_HOURS=168
# Optional. Only to run the wger import; empty means nobody.
ADMIN_USER_IDS=

# --- ACCESS ---
ENVIRONMENT=production
# TODO: the hostname from `tailscale funnel status`, e.g. zimaos.tailxxxx.ts.net
# Keep 127.0.0.1 and localhost for the container HEALTHCHECK.
ALLOWED_HOSTS=127.0.0.1,localhost,zimaos.tailxxxx.ts.net
CORS_ORIGINS=https://zimaos.tailxxxx.ts.net
# Loopback port the tunnel forwards to: `tailscale funnel --bg 8080`.
# If 8080 is taken, change this number and use the same one in the funnel
# command (`tailscale funnel --bg 8085`), or the tunnel keeps hitting the
# wrong service and answers 502.
APP_PORT=8080
WEB_CONCURRENCY=1

# Leave empty: nginx serves the SPA and proxies /api on the same origin,
# which is what the CSP ("connect-src 'self'") expects.
VITE_API_URL=

# --- Reachability ---
# Compose publishes 127.0.0.1:${APP_PORT} only, so the app is not visible on
# the LAN and there is nothing to firewall. Access it through Tailscale:
#   tailscale funnel --bg 8080   -> public HTTPS on the .ts.net host
#   tailscale serve --bg 8080    -> tailnet-only, no public exposure
# To reach it from the LAN instead, change the compose ports to
# "${APP_PORT}:8080" and add the machine's LAN IP to ALLOWED_HOSTS.
